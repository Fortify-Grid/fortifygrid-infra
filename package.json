{
  "name": "fortifygrid-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "docs": "node platform/tools/generate-docs.mjs",
    "test": "node --test 'platform/**/*.test.mjs'",
    "check": "node platform/tools/generate-docs.mjs --check && npm test && wrangler deploy --dry-run --outdir .wrangler/dry",
    "db:schema": "wrangler d1 execute fortifygrid-portal --remote --file=schema.sql",
    "db:schema:local": "wrangler d1 execute fortifygrid-portal --local --file=schema.sql",
    "deploy": "npm run db:schema && wrangler deploy",
    "setup": "node infra/cf-setup.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  }
}
